# -------------------------------------------------------------
# ClutchAI Environment Configuration Template
# Copy this file to .env.local and populate with your live keys
# -------------------------------------------------------------

# Server-Side API Keys (Used by /api/interview, /api/retrieve, /api/tts)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AQ_your_gemini_api_key_here

# Firebase Authentication Configuration (Vite Client Variables)
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps (Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
